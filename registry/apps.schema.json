{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.ivanjairus.xyz/static/schema/apps.schema.json",
  "title": "Gateway app registry",
  "type": "object",
  "required": ["site", "apps"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "site": {
      "type": "object",
      "required": ["origin", "title"],
      "additionalProperties": false,
      "properties": {
        "origin": { "type": "string", "pattern": "^https://www\\.[a-z0-9.-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "monogram": { "type": "string", "minLength": 1, "maxLength": 3 },
        "hero": { "type": "string" },
        "sub": { "type": "string" }
      }
    },
    "categoryMeta": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["title"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slug", "origin", "framework", "status", "sitemap", "cards"],
        "additionalProperties": false,
        "properties": {
          "slug": { "$ref": "#/$defs/slug" },
          "origin": { "type": "string", "pattern": "^https://ij-[a-z0-9-]+\\.vercel\\.app$" },
          "framework": { "enum": ["static", "vite"] },
          "status": { "$ref": "#/$defs/status" },
          "sitemap": { "type": "boolean" },
          "legacyRedirects": {
            "type": "array",
            "items": { "type": "string", "pattern": "^/[A-Za-z0-9._/:*()-]+$" }
          },
          "cards": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "path", "title", "summary", "category", "icon", "order"],
              "additionalProperties": false,
              "properties": {
                "id": { "$ref": "#/$defs/slug" },
                "path": { "type": "string", "pattern": "^([a-z0-9-]+/)*$" },
                "title": { "type": "string", "minLength": 1 },
                "summary": { "type": "string", "minLength": 1 },
                "category": { "$ref": "#/$defs/slug" },
                "icon": { "type": "string", "pattern": "^/static/img/apps/[a-z0-9-]+\\.svg$" },
                "order": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "status": {
      "description": "live: rewrite plus card plus sitemap. hidden: rewrite only. draft: card marked as not built, no rewrite, no sitemap.",
      "enum": ["live", "hidden", "draft"]
    }
  }
}
